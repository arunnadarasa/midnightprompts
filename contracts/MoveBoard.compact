// contracts/MoveBoard.compact
//
// Bboard-pattern demo — mirrors the public shape of
// https://github.com/midnightntwrk/example-bboard (post + take with a
// private-author ZK commitment), reimplemented on our pinned toolchain
// (Compact 0.23, MidnightJS 4.1.1).
//
// Deploy once from a local machine, pin the address in
// src/data/moveboard-contract.<network>.json, and every visitor can call
// post()/take() against the same on-chain contract. No fresh deploy per
// user — only the (much smaller) callTx DUST cost.

pragma language_version 0.23;

import CompactStandardLibrary;

// Public ledger state — visible via the Indexer, no wallet required.
export ledger board_state: Uint<8>;                 // 0 = vacant, 1 = occupied
export ledger poster_commitment: Bytes<32>;
export ledger move_label: Opaque<"string">;
export ledger move_count: Counter;

// Private input from TypeScript. Never touches chain.
witness localSecretKey(): Bytes<32>;

constructor() {
  // Explicit zero — mirrors bboard's initial vacant state.
  board_state = 0;
}

export circuit authorCommitment(sk: Bytes<32>, seq: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "moveboard:poster:"), seq, sk]
  );
}

export circuit post(label: Opaque<"string">): [] {
  assert(board_state == 0, "board occupied");
  const sk = localSecretKey();
  const seq = move_count as Field as Bytes<32>;
  poster_commitment = disclose(authorCommitment(sk, seq));
  move_label = disclose(label);
  board_state = disclose(1);
  move_count.increment(1);
}

export circuit take(): [] {
  assert(board_state == 1, "board vacant");
  const sk = localSecretKey();
  const seq = ((move_count as Field) - 1) as Bytes<32>;
  assert(
    authorCommitment(sk, seq) == poster_commitment,
    "caller is not the original poster"
  );
  board_state = disclose(0);
}
